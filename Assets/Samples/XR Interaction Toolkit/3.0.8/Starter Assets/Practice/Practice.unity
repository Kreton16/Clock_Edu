--- !u!114 &521832331
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 521832330}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 34282df3959a4f14a87a86a225df7ad9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  scenarioText: {fileID: 0}
  scenarios:
  - text: "\u041D\u0430 \u0434\u0432\u043E\u0440\u0456 \u0445\u043E\u043B\u043E\u0434\u043D\u043E,
      \u0439\u0434\u0435 \u0441\u043D\u0456\u0433 \u0456 \u043C\u043E\u0440\u043E\u0437
      \u043C\u0456\u043D\u0443\u0441 10 \u0433\u0440\u0430\u0434\u0443\u0441\u0456\u0432.
      \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0432\u0434\u044F\u0433\u043D\u0443\u0442\u0438
      \u0442\u0435\u043F\u043B\u0435 \u0437\u0438\u043C\u043E\u0432\u0435 \u0432\u0437\u0443\u0442\u0442\u044F.
      \u0412\u0438\u0431\u0435\u0440\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0435
      \u0432\u0437\u0443\u0442\u0442\u044F \u0442\u0430 \u043F\u043E\u0441\u0442\u0430\u0432
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0438\u043A \u0437\u043B\u0456\u0432\u0430
      \u0432\u0456\u0434 \u0442\u0435\u0431\u0435."
    requiredTag: Snow
  - text: "\u0421\u043E\u043D\u044F\u0447\u043D\u0438\u0439 \u0434\u0435\u043D\u044C.
      \u0422\u0438 \u0437\u0431\u0438\u0440\u0430\u0454\u0448\u0441\u044F \u043D\u0430
      \u043F\u0440\u043E\u0433\u0443\u043B\u044F\u043D\u043A\u0443 \u0430\u0431\u043E
      \u043F\u043E\u0433\u0440\u0430\u0442\u0438 \u0443 \u0444\u0443\u0442\u0431\u043E\u043B
      \u0456\u0437 \u0434\u0440\u0443\u0437\u044F\u043C\u0438. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0437\u0440\u0443\u0447\u043D\u0435 \u0432\u0437\u0443\u0442\u0442\u044F \u0434\u043B\u044F
      \u0440\u0443\u0445\u0443. \u0412\u0438\u0431\u0435\u0440\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0435
      \u0432\u0437\u0443\u0442\u0442\u044F \u0442\u0430 \u043F\u043E\u0441\u0442\u0430\u0432
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0438\u043A \u0437\u043B\u0456\u0432\u0430
      \u0432\u0456\u0434 \u0442\u0435\u0431\u0435."
    requiredTag: Sneakers
  - text: "\u0421\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u0432 \u0442\u0435\u0431\u0435
      \u0441\u0432\u044F\u0442\u043E \u2014 \u0442\u0438 \u0439\u0434\u0435\u0448
      \u043D\u0430 \u0434\u0435\u043D\u044C \u043D\u0430\u0440\u043E\u0434\u0436\u0435\u043D\u043D\u044F
      \u0430\u0431\u043E \u0432 \u0442\u0435\u0430\u0442\u0440. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0432\u0437\u0443\u0442\u0438\u0441\u044C \u043E\u0445\u0430\u0439\u043D\u043E
      \u0439 \u043A\u0440\u0430\u0441\u0438\u0432\u043E. \u0412\u0438\u0431\u0435\u0440\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0435 \u0432\u0437\u0443\u0442\u0442\u044F
      \u0442\u0430 \u043F\u043E\u0441\u0442\u0430\u0432 \u043D\u0430 \u0441\u0442\u043E\u043B\u0438\u043A
      \u0437\u043B\u0456\u0432\u0430 \u0432\u0456\u0434 \u0442\u0435\u0431\u0435."
    requiredTag: Shoe
  - text: "\u0422\u0438 \u0433\u043E\u0442\u0443\u0454\u0448\u0441\u044F \u0434\u043E
      \u0444\u0443\u0442\u0431\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u0442\u0440\u0435\u043D\u0443\u0432\u0430\u043D\u043D\u044F
      \u043D\u0430 \u043F\u043E\u043B\u0456. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
      \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u0435 \u0432\u0437\u0443\u0442\u0442\u044F,
      \u044F\u043A\u0435 \u0434\u043E\u0431\u0440\u0435 \u0442\u0440\u0438\u043C\u0430\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0442\u0440\u0430\u0432\u0456. \u0412\u0438\u0431\u0435\u0440\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0435 \u0432\u0437\u0443\u0442\u0442\u044F
      \u0442\u0430 \u043F\u043E\u0441\u0442\u0430\u0432 \u043D\u0430 \u0441\u0442\u043E\u043B\u0438\u043A
      \u0437\u043B\u0456\u0432\u0430 \u0432\u0456\u0434 \u0442\u0435\u0431\u0435."
    requiredTag: Football
  - text: "\u041D\u0430 \u0432\u0443\u043B\u0438\u0446\u0456 \u0434\u043E\u0449,
      \u0432\u0441\u044E\u0434\u0438 \u043A\u0430\u043B\u044E\u0436\u0456. \u0429\u043E\u0431
      \u043D\u0435 \u043D\u0430\u043C\u043E\u0447\u0438\u0442\u0438 \u043D\u043E\u0433\u0438,
      \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0432\u0437\u0443\u0442\u0438
      \u0432\u043E\u0434\u043E\u043D\u0435\u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0435
      \u0432\u0437\u0443\u0442\u0442\u044F. \u0412\u0438\u0431\u0435\u0440\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0435 \u0432\u0437\u0443\u0442\u0442\u044F
      \u0442\u0430 \u043F\u043E\u0441\u0442\u0430\u0432 \u043D\u0430 \u0441\u0442\u043E\u043B\u0438\u043A
      \u0437\u043B\u0456\u0432\u0430 \u0432\u0456\u0434 \u0442\u0435\u0431\u0435."
    requiredTag: Rubber
  - text: "\u0421\u043F\u0435\u043A\u043E\u0442\u043D\u0438\u0439 \u043B\u0456\u0442\u043D\u0456\u0439
      \u0434\u0435\u043D\u044C. \u0422\u0438 \u0439\u0434\u0435\u0448 \u043D\u0430
      \u043F\u0440\u043E\u0433\u0443\u043B\u044F\u043D\u043A\u0443 \u0432 \u043F\u0430\u0440\u043A.
      \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u043B\u0435\u0433\u043A\u0435
      \u0432\u0437\u0443\u0442\u0442\u044F, \u0449\u043E\u0431 \u043D\u043E\u0437\u0456
      \u0431\u0443\u043B\u043E \u043D\u0435 \u0436\u0430\u0440\u043A\u043E. \u0412\u0438\u0431\u0435\u0440\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0435 \u0432\u0437\u0443\u0442\u0442\u044F
      \u0442\u0430 \u043F\u043E\u0441\u0442\u0430\u0432 \u043D\u0430 \u0441\u0442\u043E\u043B\u0438\u043A
      \u0437\u043B\u0456\u0432\u0430 \u0432\u0456\u0434 \u0442\u0435\u0431\u0435."
    requiredTag: Sandal
  currentCorrectTag: 
